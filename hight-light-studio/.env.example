# Copie ce fichier en .env.local et remplis tes clés.
# Ne commit JAMAIS le fichier .env.local sur GitHub.

# Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# GLM-5.2 (Zhipu AI / Z.ai) — https://z.ai (plateforme API)
ZAI_API_KEY=

# Gemma 4 via NVIDIA NIM — https://build.nvidia.com
NVIDIA_API_KEY=

# Nano Banana / Nano Banana Pro (Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Kimi (Moonshot AI) — K2.7-Code et K3
# Clé disponible sur https://platform.kimi.ai/console/account
# Compatible OpenAI, même endpoint pour K2.7 et K3.
KIMI_API_KEY=

# Wan 2.7 (Alibaba) — https://www.alibabacloud.com/help/en/model-studio
ALIBABA_API_KEY=

# OpenRouter (GLM-5.2 et Gemma 4) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mode Agent (Phase 6) — dossier sandbox où l'agent peut lire/écrire des
# fichiers et exécuter des commandes. Par défaut : ./workspace
AGENT_WORKSPACE_DIR=

# Base de données et Storage (Phase 4) — Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Preview live (dashboard 2 panneaux) — URL du dev server lancé dans workspace/
# Défaut : http://localhost:3001
NEXT_PUBLIC_PREVIEW_URL=http://localhost:3001

# GitHub Export (Phase Import/Export) — token personnel à portée RÉDUITE.
# ⚠️  NE JAMAIS créer un token avec accès à tous les repos.
# ⚠️  NE JAMAIS commiter ce token ni le logguer.
# Scope recommandé : "repo" sur le dépôt cible uniquement (fine-grained PAT).
# Créer un token : https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=

# Mode Agent Headless (Phase 6a) — clé d'API pour appels externes (CI/CD, scripts).
# Si vide, l'endpoint /api/agent reste ouvert (usage local uniquement).
# Génère une clé aléatoire : openssl rand -hex 32
HL_AGENT_API_KEY=
