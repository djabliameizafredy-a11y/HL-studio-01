# Copie ce fichier en .env.local et remplis tes clés.
# Ne commit JAMAIS le fichier .env.local sur GitHub.

# Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# GLM-5.2 (Zhipu AI / Z.ai) — https://z.ai (plateforme API)
ZAI_API_KEY=

# Gemma 4 via NVIDIA NIM — https://build.nvidia.com
NVIDIA_API_KEY=

# Nano Banana / Nano Banana Pro (Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Kimi K2.7-Code (Moonshot AI) — https://platform.kimi.ai
KIMI_API_KEY=

# Wan 2.7 (Alibaba) — https://www.alibabacloud.com/help/en/model-studio
ALIBABA_API_KEY=

# Mode Agent (Phase 6) — dossier sandbox où l'agent peut lire/écrire des
# fichiers et exécuter des commandes. Par défaut : ./workspace
AGENT_WORKSPACE_DIR=
